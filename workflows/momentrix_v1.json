{
  "name": "MOMENTRIX v1 · Local clipping",
  "nodes": [
    {
      "parameters": {},
      "id": "f289e23c-05c5-4ae7-b7a2-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        40
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "backend_url",
              "name": "backend_url",
              "value": "http://host.docker.internal:8000",
              "type": "string"
            },
            {
              "id": "filename",
              "name": "filename",
              "value": "Momentrix sample.mp4",
              "type": "string"
            },
            {
              "id": "campaign",
              "name": "campaign",
              "value": "default",
              "type": "string"
            },
            {
              "id": "count",
              "name": "count",
              "value": 3,
              "type": "number"
            },
            {
              "id": "layout",
              "name": "layout",
              "value": "fit",
              "type": "string"
            },
            {
              "id": "subtitles",
              "name": "subtitles",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "authorized",
              "name": "authorized",
              "value": false,
              "type": "boolean"
            },
            {
              "id": "max_attempts",
              "name": "max_attempts",
              "value": 120,
              "type": "number"
            },
            {
              "id": "timeout_minutes",
              "name": "timeout_minutes",
              "value": 60,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "f289e23c-05c5-4ae7-b7a2-000000000002",
      "name": "Job configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        40
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Job configuration').first().json.backend_url.replace(/\\/$/, '') + '/health' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "id": "f289e23c-05c5-4ae7-b7a2-000000000003",
      "name": "Check backend health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        40
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "url": "={{ $('Job configuration').first().json.backend_url.replace(/\\/$/, '') + '/jobs' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        },
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filename: $('Job configuration').first().json.filename, campaign: $('Job configuration').first().json.campaign, count: $('Job configuration').first().json.count, layout: $('Job configuration').first().json.layout, subtitles: $('Job configuration').first().json.subtitles, authorized: $('Job configuration').first().json.authorized }) }}"
      },
      "id": "f289e23c-05c5-4ae7-b7a2-000000000004",
      "name": "Create job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        40
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": 30,
        "unit": "seconds"
      },
      "id": "f289e23c-05c5-4ae7-b7a2-000000000005",
      "name": "Wait 30 seconds",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        910,
        40
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Job configuration').first().json.backend_url.replace(/\\/$/, '') + '/jobs/' + encodeURIComponent($('Create job').first().json.job_id) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "id": "f289e23c-05c5-4ae7-b7a2-000000000006",
      "name": "Get job status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        40
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "status",
              "leftValue": "={{ ['completed', 'completed_with_warnings'].includes($json.status) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f289e23c-05c5-4ae7-b7a2-000000000007",
      "name": "Job succeeded",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1370,
        40
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "status",
              "leftValue": "={{ ['failed', 'cancelled'].includes($json.status) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f289e23c-05c5-4ae7-b7a2-000000000008",
      "name": "Job failed or cancelled",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1590,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "status",
              "leftValue": "={{ $runIndex + 1 >= $('Job configuration').first().json.max_attempts || Date.now() >= Date.parse($('Create job').first().json.created_at) + $('Job configuration').first().json.timeout_minutes * 60000 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f289e23c-05c5-4ae7-b7a2-000000000009",
      "name": "Polling limit reached",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1820,
        340
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "job_id",
              "name": "job_id",
              "value": "={{ $json.job_id }}",
              "type": "string"
            },
            {
              "id": "status",
              "name": "status",
              "value": "={{ $json.status }}",
              "type": "string"
            },
            {
              "id": "output",
              "name": "output",
              "value": "={{ $json.output }}",
              "type": "string"
            },
            {
              "id": "warnings",
              "name": "warnings",
              "value": "={{ $json.warnings }}",
              "type": "array"
            }
          ]
        },
        "options": {}
      },
      "id": "f289e23c-05c5-4ae7-b7a2-000000000010",
      "name": "Success output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1590,
        -80
      ]
    },
    {
      "parameters": {
        "errorMessage": "={{ 'MOMENTRIX job ' + $json.job_id + ' ended as ' + $json.status + '. ' + ($json.error || '') }}"
      },
      "id": "f289e23c-05c5-4ae7-b7a2-000000000011",
      "name": "Job error",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1820,
        160
      ]
    },
    {
      "parameters": {
        "errorMessage": "={{ 'Polling limit reached for MOMENTRIX job ' + $json.job_id + '. The backend may still be processing it.' }}"
      },
      "id": "f289e23c-05c5-4ae7-b7a2-000000000012",
      "name": "Polling timeout",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        2050,
        300
      ]
    },
    {
      "parameters": {
        "errorMessage": "MOMENTRIX API request failed. Check the failed HTTP node, backend connectivity and the X-API-Token credential."
      },
      "id": "f289e23c-05c5-4ae7-b7a2-000000000013",
      "name": "HTTP request error",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1380,
        640
      ]
    }
  ],
