# Copy to .env for local overrides. Empty token enables loopback-only operation.
MOMENTRIX_API_TOKEN=
MOMENTRIX_N8N_URL=http://127.0.0.1:5678
MOMENTRIX_WEBHOOK_SECRET=
MOMENTRIX_SERVICE_TOKEN=
# Optional n8n scheduled ingestion. List only filenames you authorize from input/.
MOMENTRIX_SCHEDULED_FILENAMES=[]
MOMENTRIX_SCHEDULED_AUTO_PROCESS=false
MOMENTRIX_SCHEDULED_CAMPAIGN=default
MOMENTRIX_FFMPEG=ffmpeg
MOMENTRIX_FFPROBE=ffprobe
MOMENTRIX_WHISPER_MODEL=base.en
MOMENTRIX_WHISPER_DEVICE=cpu
MOMENTRIX_WHISPER_COMPUTE_TYPE=int8
MOMENTRIX_CPU_THREADS=4
MOMENTRIX_OLLAMA_URL=http://localhost:11434
MOMENTRIX_OLLAMA_MODEL=qwen2.5:3b
MOMENTRIX_OLLAMA_TIMEOUT=180
MOMENTRIX_OLLAMA_ATTEMPTS=2
MOMENTRIX_MAX_INPUT_BYTES=12884901888
MOMENTRIX_MAX_SOURCE_SECONDS=14400
MOMENTRIX_MINIMUM_FREE_BYTES=536870912
MOMENTRIX_FFMPEG_TIMEOUT=1800
MOMENTRIX_FPS=30
MOMENTRIX_CRF=21
MOMENTRIX_FFMPEG_PRESET=veryfast
